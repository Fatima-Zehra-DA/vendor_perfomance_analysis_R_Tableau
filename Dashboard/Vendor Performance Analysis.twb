      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0on1xea17tajmo15vu0ug0e35mf2].[sum:TotalPurchaseDollars:qk]&quot;' value='Total Purchase Cost' />
          <alias key='&quot;[federated.0on1xea17tajmo15vu0ug0e35mf2].[sum:TotalSalesDollars:qk]&quot;' value='Total Sales' />
        </aliases>
      </column>
      <column caption='Actual Price' datatype='real' name='[ActualPrice]' role='measure' type='quantitative' />
      <column caption='Gross Margin%' datatype='real' name='[Calculation_0467875291926528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(GrossProfit) / SUM(TotalSalesDollars)' />
      </column>
      <column caption='Cumulative Sales %' datatype='real' name='[Calculation_0467875307118593]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([TotalSalesDollars]))&#13;&#10;/&#13;&#10;WINDOW_SUM(SUM([TotalSalesDollars]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Vendor Sales Group' datatype='string' name='[Calculation_0467875323662338]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Top 10 Vendors by Sales] THEN&#13;&#10;    &quot;Top 10 Vendors&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Other Vendors&quot;&#13;&#10;END' />
      </column>
      <column caption='Donut' datatype='integer' name='[Calculation_0467875325911043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Purchase Contribution %' datatype='real' name='[Calculation_0467875334127620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([TotalPurchaseDollars])&#13;&#10;/&#13;&#10;MIN([Calculation_0467875354877960])' />
      </column>
      <column caption='Cumulative Purchase Contribution %' datatype='real' name='[Calculation_0467875337158662]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([TotalPurchaseDollars]))&#13;&#10;/&#13;&#10;MIN([Calculation_0467875354877960])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Purchase — All Vendors' datatype='real' name='[Calculation_0467875354877960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM([TotalPurchaseDollars]) }' />
      </column>
      <column caption='Gross Profit' datatype='real' name='[GrossProfit]' role='measure' type='quantitative' />
