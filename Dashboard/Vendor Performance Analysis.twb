          <datasource-dependencies datasource='federated.0on1xea17tajmo15vu0ug0e35mf2'>
            <column caption='Gross Margin%' datatype='real' name='[Calculation_0467875291926528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(GrossProfit) / SUM(TotalSalesDollars)' />
            </column>
            <column caption='Gross Profit' datatype='real' name='[GrossProfit]' role='measure' type='quantitative' />
            <column caption='Total Sales Dollars' datatype='real' name='[TotalSalesDollars]' role='measure' type='quantitative' />
            <column caption='Vendor Name' datatype='string' name='[VendorName]' role='dimension' type='nominal' />
            <column-instance column='[VendorName]' derivation='None' name='[none:VendorName:nk]' pivot='key' type='nominal' />
            <column-instance column='[TotalSalesDollars]' derivation='Sum' name='[sum:TotalSalesDollars:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0467875291926528]' derivation='User' name='[usr:Calculation_0467875291926528:qk]' pivot='key' type='quantitative' />
